# Copy this file to `.env` and fill in whichever provider you use.
# fpl_agent loads these automatically via python-dotenv.

# Option A: OpenAI (default model: gpt-4o-mini)
OPENAI_API_KEY=

# Option B: Google Gemini (default model: gemini/gemini-1.5-flash)
GEMINI_API_KEY=

# Optional overrides
# FPL_AGENT_MODEL=gpt-4o-mini
# FPL_AGENT_CACHE_TTL_SECONDS=600
