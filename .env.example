# Copy this file to `.env` and fill in whichever provider you use.
# fpl_agent loads these automatically via python-dotenv.

# Option A: Groq free tier (default model: groq/openai/gpt-oss-20b)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Option B: OpenAI (default model: gpt-4o-mini)
OPENAI_API_KEY=

# Option C: Google Gemini (default model: gemini/gemini-1.5-flash)
GEMINI_API_KEY=

# Optional overrides
# FPL_AGENT_MODEL=groq/openai/gpt-oss-20b
# FPL_AGENT_CACHE_TTL_SECONDS=600

# --- Local rate limiting (client-side safety net; see fpl_agent/rate_limiter.py) ---
# These are enforced locally BEFORE any LLM call is made, independent of what the
# provider itself allows - so usage can never run away past a free tier. Defaults
# are calibrated to ~50-75% of Groq's published free-tier limits for
# openai/gpt-oss-20b (30 RPM / 1,000 RPD / 8,000 TPM) - check your account's exact
# current limits at https://console.groq.com/settings/limits before raising them.
# FPL_AGENT_MAX_RPM=15
# FPL_AGENT_MAX_RPD=250
# FPL_AGENT_MAX_TPM=6000
