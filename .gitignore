# Secrets / environment variables
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# fpl_agent local runtime state (rate-limit counters, not source)
fpl_agent/.rate_limit_state.json

# Node / frontend (frontend/ has its own .gitignore too, kept here as a safety net)
node_modules/
frontend/build/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
